# Copy to .env and fill in. .env is gitignored — never commit real keys.

# One of these is required. The provider is auto-detected from whichever is set.
ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...

# Optional overrides
# RESUME_PROVIDER=anthropic        # anthropic | openai
# RESUME_MODEL=claude-opus-5       # override the provider's default model

# Wall-clock budget for one run, in seconds. 900 is what a COMPLETE run costs;
# lowering it stops the loop early and measurably reduces keyword coverage.
# RUN_BUDGET_SECONDS=900
# TAIL_RESERVE_SECONDS=80          # reserved for the closing phases
# PROVIDER_TIMEOUT_SECONDS=180     # per-request timeout
# PROVIDER_MAX_RETRIES=3           # SDK-level retries on connection failures

# Gate the SERVER's API key behind a PIN. Leave unset locally; set it in your
# hosting provider's environment on any public deployment, or anyone who finds
# the URL can spend your credits. Never commit a real value.
# ACCESS_PIN=
# Provider for PIN-unlocked runs (they spend YOUR credits, so you choose).
# A visitor's own key always routes to that key's provider regardless.
# PIN_PROVIDER=openai
# SESSION_SECRET=            # HMAC secret for session tokens; set in production
# ACCESS_SESSION_HOURS=720
